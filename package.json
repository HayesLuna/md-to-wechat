{
  "name": "mojian-md-to-wechat",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src tests && tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.tests.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" tsconfig.tests.json package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js .prettierrc.json .github/workflows/pages.yml",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" tsconfig.tests.json package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js .prettierrc.json .github/workflows/pages.yml"
  },
  "dependencies": {
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/markdown": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.0"
  }
}
